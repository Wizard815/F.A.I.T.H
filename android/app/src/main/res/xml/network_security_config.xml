<?xml version="1.0" encoding="utf-8"?>
<!-- FAITH usually runs on the home network over plain http (http://192.168.x.x:8097).
     Use https (your reverse proxy) when you reach it from outside the house. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
