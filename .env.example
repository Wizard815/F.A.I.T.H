# FAITH's secrets. faith.yaml only names these variables; the values live here.
# chmod 600 .env. Never commit it.

TZ=America/Detroit
FAITH_APPDATA=/mnt/user/appdata/faith
# FAITH_PUBLIC_URL=https://faith.home.lan   # overrides public_url in faith.yaml

# The engine (Argos). Empty if Argos has no API keys.
ARGOS_API_KEY=

# Family wiki (LLM-will-remember-this), on the vault host:
#   node scripts/family-setup.mjs add-shared faith FAITH && node scripts/family-setup.mjs token faith
WIKI_TOKEN_HOUSEHOLD=
#   node scripts/family-setup.mjs token <id>   (one per member)
WIKI_TOKEN_WIZARD=
WIKI_TOKEN_PARTNER=

# ALLGlance (needs GATEWAY_TOKEN set there, or scoped tokens limit nothing):
#   docker exec allglance node scripts/tokens.mjs add-household faith
ALLGLANCE_TOKEN_HOUSEHOLD=
#   docker exec allglance node scripts/tokens.mjs add-person <owner_id> faith-<id>
ALLGLANCE_TOKEN_WIZARD=
ALLGLANCE_TOKEN_PARTNER=

# Home Assistant: a long-lived token of a non-admin HA user named "FAITH"
HA_TOKEN=

# Coinpile: a scoped token per person with the mcp scope (Coinpile > Settings > Tokens)
COINPILE_TOKEN_WIZARD=
COINPILE_TOKEN_PARTNER=

# Pondering Orb (Wizard's only): add faith:<token> to ORB_API_TOKENS on the Orb
ORB_TOKEN_WIZARD=

# Hermes agent API server (API_SERVER_KEY there)
HERMES_API_KEY=

# Hermes Studio with owner: set (one person links it): that one Studio account
STUDIO_USER=
STUDIO_PASSWORD=
# Without owner: each person's own Studio account
# STUDIO_USER_WIZARD=
# STUDIO_PASSWORD_WIZARD=

# Mattermost: the token of the "faith" bot account (System Console > Bot Accounts)
MATTERMOST_BOT_TOKEN=

# The kid's card: a Firefly III personal access token (rewards.payout: firefly)
FIREFLY_TOKEN=
