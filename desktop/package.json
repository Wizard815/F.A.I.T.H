{
  "name": "faith-desktop",
  "productName": "FAITH",
  "private": true,
  "version": "0.1.0",
  "description": "FAITH on your computer: ask, talk, Yes/No, notifications from the tray.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Wizard815/F.A.I.T.H",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wizard815/F.A.I.T.H.git",
    "directory": "desktop"
  },
  "author": "FAITH",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs && vite build",
    "start": "npm run build && electron .",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "npm run build && node --import tsx --test e2e/*.test.ts",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.66.0",
    "playwright": "1.65.0",
    "postcss": "8.5.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "build": {
    "appId": "family.faith.desktop",
    "productName": "FAITH",
    "copyright": "FAITH",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "FAITH",
      "synopsis": "FAITH, the family's assistant"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libsecret-1-0"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FAITH listens while you hold the microphone button, to answer what you say."
      }
    }
  }
}
